<Page x:Class="SketchProMax.UI.ChatPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sketch ProMax" Background="White" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,6">
      <Button x:Name="NewChatButton" DockPanel.Dock="Right" Content="New chat" Padding="8,2" Click="OnNewChat" />
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings" Padding="8,2" Margin="0,0,6,0" Click="OnSettings" />
      <TextBlock Text="Sketch ProMax" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
    </DockPanel>

    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Transcript" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,4">
      <TextBlock x:Name="AttachmentsText" Foreground="SteelBlue" TextWrapping="Wrap" />
      <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>

    <DockPanel Grid.Row="3">
      <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Width="70" Margin="6,0,0,0" Click="OnSend" />
      <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop" Width="60" Margin="6,0,0,0" Click="OnStop" IsEnabled="False" />
      <Button x:Name="AttachButton" DockPanel.Dock="Left" Content="📎" Width="32" Margin="0,0,6,0" Click="OnAttach"
              ToolTip="Attach pictures or PDFs (product photos, cut sheets, sketches)" />
      <TextBox x:Name="Input" MinHeight="60" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKeyDown"
               ToolTip="Ask Sketch ProMax. Enter to send, Shift+Enter for a new line." />
    </DockPanel>
  </Grid>
</Page>
