<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build for a specific Revit release with:  dotnet build -c Release -p:RevitVersion=2026
    Revit 2024 runs on .NET Framework 4.8; Revit 2025 and 2026 on .NET 8; Revit 2027 on .NET 10.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025' AND '$(RevitVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SketchProMax</RootNamespace>
    <AssemblyName>SketchProMax</AssemblyName>
    <Version>0.34.12</Version>
    <!-- Copy NuGet dependencies (System.Text.Json on Revit 2024) next to the add-in DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only Revit API assemblies; Revit supplies the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Roslyn compiles the C# snippets run by run_revit_code. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- .NET Framework 4.8 (Revit 2024): reference assemblies plus compiler polyfills for modern C#. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SketchProMax.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The loader is what Revit loads (SketchProMax.addin names it); it ships next to this DLL in every build. The core
    references it only so that a manifest written by 0.25.x, which still names SketchProMax.App, can hand over to it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SketchProMax.Loader\SketchProMax.Loader.csproj" />
  </ItemGroup>

  <!-- The product logo and icon, for the update window and dialogs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo\sketch-promax-64.png" LogicalName="SketchProMax.logo-64.png" />
    <EmbeddedResource Include="..\..\assets\logo\sketch-promax.ico" LogicalName="SketchProMax.sketch-promax.ico" />
    <!-- The chat home screen's prompt library (Chat/PromptLibrary). -->
    <EmbeddedResource Include="Chat\chat-prompts.json" LogicalName="SketchProMax.chat-prompts.json" />
  </ItemGroup>

  <!-- The built-in embodied carbon factor table (generic placeholders, versioned inside the file). -->
  <ItemGroup>
    <EmbeddedResource Include="Data\carbon-factors.csv" LogicalName="SketchProMax.carbon-factors.csv" />
  </ItemGroup>

  <!-- The office's pre-submission checklist, built in (names of people, the client and the project taken out). Edited copies live in %APPDATA%. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\pre-submission-checklist.json" LogicalName="SketchProMax.pre-submission-checklist.json" />
  </ItemGroup>

  <!-- Step-by-step help guides (Tools/HelpGuides), the same files as docs/guides. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\guides\*.md" LogicalName="SketchProMax.guides.%(Filename).md" />
  </ItemGroup>
  <!-- The bug log as released, for the test checklist's "bug fixes" steps when the downloaded copy isn't there yet. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\bug-log.md" LogicalName="SketchProMax.bug-log.md" />
  </ItemGroup>

  <!-- On Windows, copy the build into the per-user Revit add-ins folder so Revit picks it up. -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' AND '$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <AddinRoot>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinRoot>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)SketchProMax.addin" />
    </ItemGroup>
    <Copy SourceFiles="$(OutputPath)SketchProMax.addin" DestinationFolder="$(AddinRoot)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(AddinRoot)SketchProMax\%(RecursiveDir)" />
  </Target>

</Project>
